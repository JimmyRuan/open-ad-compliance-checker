# Optional. Copy to .env only if you want generated verdicts.
#
#   cp .env.example .env    # then paste a key below
#
# With no key the app runs retrieval-only: real citations, provision text and
# eCFR links from local retrieval, and nothing leaves the machine. The brief
# makes the LLM optional, so that is a supported mode rather than a failure.

OPENAI_API_KEY=

# Must be a reasoning model: the request sends `reasoning.effort` and strict
# structured outputs, which the older chat models reject.
LLM_MODEL=gpt-5

# Reasoning tokens dominate latency (~3x the visible output). Measured per
# check on ad `a1`: minimal ~21s, low ~35s, medium ~65s, high ~95s.
LLM_ASSESS_EFFORT=low

# Host port for the app.
PORT=8088
